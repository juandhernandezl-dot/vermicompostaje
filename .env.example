# Copia este archivo como .env (cp .env.example .env) y ajusta.

# ---- MODO: una sola linea decide si se riega la cama real o la simulada ----
# Huerto (USB reales):
COMPOSE_FILE=docker-compose.yml
# Simulacion (sin hardware): descomenta la siguiente y comenta la anterior.
#COMPOSE_FILE=docker-compose.yml:docker-compose.sim.yml

# Donde viven los datos de MongoDB y el respaldo CSV (FUERA del repo).
DATOS_DIR=/home/gitcode1/vermi-datos

# Adaptadores USB reales (ls -l /dev/serial/by-id/). Solo modo huerto.
SENSORES_USB=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_A5069RR4-if00-port0
ESP32_USB=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0

# Lectura de los SN-3002: bloque (1 trama) o individual (si algun canal sale en 0).
MODO_LECTURA=bloque

# Fisica acelerada de la planta simulada (solo modo simulacion).
ESCALA=10

# Agente (perfil "agente"): modelo de Ollama y tope de RAM del contenedor.
LLM_MODEL=qwen3.5:4b
OLLAMA_MEM=5g

# Puerto del dashboard de Node-RED en la Pi (1881 si huerto-bot usa el 1880).
NODERED_PUERTO=1880

# Contraseñas de Node-RED (editor = admin; dashboard = quien riega). Se guarda el
# HASH bcrypt, nunca la clave. Genera cada hash en la Pi:   bash scripts/hash_clave.sh
# Pega el hash ENTRE COMILLAS SIMPLES: lleva '$' y sin comillas Compose lo interpreta.
# Si falta un par, ese acceso queda bloqueado (Node-RED sigue publicando lotes).
NODERED_ADMIN_USUARIO=admin
NODERED_ADMIN_HASH=''
NODERED_DASH_USUARIO=huerto
NODERED_DASH_HASH=''
